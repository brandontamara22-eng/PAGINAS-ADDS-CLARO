<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Compara planes de internet para tu hogar y solicita una llamada.">
  <title>Conecta Hogar | Internet para tu casa</title>
  <style>
    :root{--red:#e3262e;--red2:#ff454d;--ink:#20232a;--muted:#646a73;--soft:#f6f7f9;--line:#e5e7eb;--green:#19b66a;--shadow:0 18px 50px #10182816}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:var(--ink);background:#fff}button,input{font:inherit}a{text-decoration:none;color:inherit}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}
    .nav{height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;font-size:22px}.brand-mark{width:58px;height:58px;object-fit:contain;display:block;filter:drop-shadow(0 8px 12px #e3262e35)}.dealer-ribbon{position:relative;width:100%;min-height:62px;background:#ed1c24;color:#fff;padding:17px 220px 18px 20px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:19px;font-weight:850;letter-spacing:-.01em;box-shadow:0 8px 24px #ed1c2426;z-index:4}.dealer-ribbon:after{content:"";position:absolute;left:42px;bottom:-14px;border-top:15px solid #ed1c24;border-left:15px solid transparent}.dealer-phone{position:absolute;right:34px;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:8px;color:#fff;font-size:18px;font-weight:900;padding:9px 13px;border-radius:10px;transition:.2s}.dealer-phone:hover{background:#ffffff18}.links{display:flex;gap:30px;font-size:14px;font-weight:700}.btn{border:0;border-radius:12px;background:var(--red);color:#fff;padding:14px 22px;font-weight:800;cursor:pointer;box-shadow:0 8px 22px #e3262e30;transition:.2s}.btn:hover{transform:translateY(-2px);background:#c9141d}.btn.ghost{background:#fff;color:var(--red);box-shadow:none;border:1px solid #ffc8ca}
    .hero{overflow:hidden;background:#070707;padding:0}.carousel{position:relative;width:100%;max-width:1120px;margin:0 auto;overflow:hidden;border-radius:0;box-shadow:none;background:#070707}.carousel-track{display:flex;transition:transform .7s cubic-bezier(.22,.8,.3,1)}.slide{min-width:100%}.slide-link{display:block;position:relative;height:clamp(390px,55vw,620px);cursor:pointer;background:#070707}.slide-link:after{content:"Haz clic para solicitar";position:absolute;right:20px;bottom:20px;padding:10px 15px;border-radius:999px;background:#ed1c24e8;color:#fff;font-size:12px;font-weight:900;box-shadow:0 8px 20px #0005;opacity:0;transform:translateY(8px);transition:.22s}.slide-link:hover:after,.slide-link:focus-visible:after{opacity:1;transform:none}.slide-promo{width:100%;height:100%;display:block;object-fit:contain}.carousel-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:46px;height:46px;border:0;border-radius:50%;background:#fffffff0;color:var(--red);font-size:29px;font-weight:900;cursor:pointer;box-shadow:0 5px 18px #0005}.carousel-arrow:hover{background:#fff}.carousel-arrow.prev{left:14px}.carousel-arrow.next{right:14px}.carousel-dots{position:absolute;left:0;right:0;bottom:16px;z-index:3;display:flex;justify-content:center;gap:7px;pointer-events:none}.carousel-dot{width:10px;height:10px;padding:0;border:0;border-radius:50%;background:#ffffff8c;cursor:pointer;transition:.2s;box-shadow:0 1px 5px #0008;pointer-events:auto}.carousel-dot.active{width:28px;border-radius:99px;background:#fff}
    section{padding:82px 0}.section-head{text-align:center;max-width:700px;margin:0 auto 38px}.section-head h2{font-size:clamp(30px,4vw,44px);letter-spacing:-.04em;margin:12px 0}.section-head p{color:var(--muted);line-height:1.6}.tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:35px}.tab{border:1px solid var(--line);background:#fff;padding:12px 18px;border-radius:999px;font-weight:800;color:#5a6069;cursor:pointer}.tab.active{background:var(--ink);color:#fff;border-color:var(--ink)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}.card{border:1px solid var(--line);border-radius:22px;padding:28px;background:#fff;position:relative;box-shadow:0 8px 24px #1018280b;display:flex;flex-direction:column}.card.featured{border:2px solid var(--red);transform:translateY(-8px);box-shadow:0 20px 50px #e3262e18}.badge{position:absolute;right:18px;top:18px;background:#fff0f1;color:var(--red);border-radius:999px;padding:7px 10px;font-size:11px;font-weight:900}.type{color:var(--muted);text-transform:uppercase;font-size:12px;font-weight:900;letter-spacing:.1em}.speed{font-size:42px;letter-spacing:-.05em;font-weight:900;margin:12px 0 3px}.speed small{font-size:18px}.bonus{color:var(--red);font-weight:800;font-size:13px;min-height:38px}.price{margin:24px 0 8px;display:flex;align-items:flex-start}.currency{font-weight:900;margin-top:8px}.amount{font-size:50px;line-height:1;font-weight:950;letter-spacing:-.06em}.cents{font-weight:900;margin-top:7px}.period{color:var(--muted);font-size:12px;align-self:flex-end;margin:0 0 6px 6px}.features{list-style:none;padding:16px 0 20px;margin:10px 0 20px;border-top:1px solid var(--line);flex:1}.features li{margin:12px 0;font-size:14px;display:flex;gap:9px;line-height:1.4}.features li:before{content:"✓";color:var(--green);font-weight:900}.card .btn{width:100%}.disclaimer{text-align:center;color:#888;font-size:11px;margin-top:25px}
    .benefits{background:var(--soft)}.benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.benefit{background:#fff;padding:24px;border-radius:18px}.icon{width:48px;height:48px;border-radius:14px;background:#fff0f1;color:var(--red);display:grid;place-items:center;font-size:23px}.benefit h3{margin:18px 0 8px;font-size:17px}.benefit p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}
    .contact{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(90deg,#17191dc9 0%,#17191d9c 45%,#17191d4d 100%),url('asesoria-claro-ampliada.png') left center/cover no-repeat;color:#fff;border-radius:30px;padding:38px 42px;display:grid;grid-template-columns:1fr .86fr;gap:42px;align-items:center;box-shadow:0 22px 55px #10182822}.contact:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,#00000008,#00000042);pointer-events:none}.contact h2{font-size:38px;letter-spacing:-.04em;margin:10px 0;text-shadow:0 2px 12px #0008}.contact p{color:#f2f3f5;line-height:1.55;max-width:480px;text-shadow:0 2px 10px #000b}.form{background:#fffffff2;backdrop-filter:blur(7px);color:var(--ink);padding:24px;border-radius:20px;box-shadow:0 20px 45px #0004}.field{margin-bottom:12px}.field label{display:block;font-size:12px;font-weight:800;margin-bottom:7px}.field input{width:100%;padding:12px 14px;border:1px solid #d9dce1;border-radius:10px;outline:none}.field input:focus{border-color:var(--red);box-shadow:0 0 0 3px #e3262e13}.check{font-size:11px;color:var(--muted);display:flex;gap:8px;line-height:1.45;margin:12px 0}.form .btn{width:100%}.message{font-size:12px;margin-top:10px;text-align:center;min-height:18px;color:var(--green);font-weight:800}
    .faq{max-width:820px;margin:auto}.faq-item{border-bottom:1px solid var(--line)}.faq-q{width:100%;border:0;background:none;padding:21px 0;display:flex;justify-content:space-between;text-align:left;font-weight:850;cursor:pointer}.faq-a{max-height:0;overflow:hidden;color:var(--muted);line-height:1.6;transition:max-height .3s}.faq-item.open .faq-a{max-height:140px;padding-bottom:22px}.plus{font-size:22px;color:var(--red);transition:.2s}.open .plus{transform:rotate(45deg)}footer{padding:38px 0;background:#17191d;color:#d1d3d7}.foot{display:flex;justify-content:space-between;gap:25px;align-items:center;font-size:12px}.wa{position:fixed;right:22px;bottom:22px;width:58px;height:58px;border-radius:50%;background:#20c76a;color:#fff;display:grid;place-items:center;font-size:26px;box-shadow:0 14px 35px #0003;z-index:5}
    @media(max-width:850px){.links{display:none}.dealer-ribbon{font-size:16px;padding:14px 190px 14px 18px}.dealer-phone{right:18px;font-size:16px}.slide-link{height:clamp(330px,70vw,520px)}.hero-grid,.contact{grid-template-columns:1fr}.visual{min-height:360px}.cards{grid-template-columns:1fr}.card.featured{transform:none}.benefit-grid{grid-template-columns:1fr 1fr}.contact{padding:30px;background-position:28% center}}
    @media(max-width:520px){.nav{height:76px}.brand-mark{width:50px;height:50px}.dealer-ribbon{min-height:78px;font-size:13px;padding:10px 12px 42px;flex-direction:column}.dealer-phone{right:50%;top:auto;bottom:5px;transform:translateX(50%);font-size:15px;white-space:nowrap}.dealer-ribbon:after{left:25px;bottom:-11px;border-top-width:12px;border-left-width:12px}.slide-link{height:auto;aspect-ratio:1475/1066}.carousel-arrow{width:34px;height:34px;font-size:22px}.carousel-arrow.prev{left:5px}.carousel-arrow.next{right:5px}.carousel-dots{bottom:7px}.slide-link:after{display:none}.wrap{width:min(100% - 24px,1160px)}h1{font-size:43px}.hero-actions{align-items:stretch;flex-direction:column}.visual{min-height:300px}.blob{width:290px;height:290px}.router{width:245px;height:180px}.router:before,.router:after{top:-65px;height:90px}.speed-chip{right:0}.rating{left:2px;bottom:20px}.benefit-grid{grid-template-columns:1fr}.contact h2{font-size:30px}.contact{border-radius:22px;padding:22px 18px;background-position:18% center}.form{padding:20px 17px}.foot{flex-direction:column;text-align:center}.cards{gap:14px}}

    /* Tema oscuro negro y rojo */
    body{background:#0a0b0e;color:#f5f6f8}.hero{background:#050506}section{border-color:#292b31}.section-head h2{color:#fff}.section-head p{color:#aeb2bb}.eyebrow{color:#ff4a51;background:#ed1c2418;border:1px solid #ed1c2433}.eyebrow:before{background:#ff353d}.benefits .eyebrow,#contacto .eyebrow,#preguntas .eyebrow{position:relative;color:#fff;background:linear-gradient(135deg,#ff3038,#c60914);border:1px solid #ff5b61;padding:10px 17px;border-radius:9px;font-size:12px;font-weight:950;letter-spacing:.12em;box-shadow:0 8px 24px #ed1c243d,0 0 0 4px #ed1c2410;text-shadow:0 1px 2px #8c0008;text-transform:uppercase}.benefits .eyebrow:before,#contacto .eyebrow:before,#preguntas .eyebrow:before{width:8px;height:8px;background:#fff;box-shadow:0 0 9px #fff;border-radius:2px;transform:rotate(45deg)}.benefits .eyebrow:after,#contacto .eyebrow:after,#preguntas .eyebrow:after{content:"";position:absolute;left:16px;right:16px;bottom:-7px;height:2px;background:linear-gradient(90deg,#ff3f47,transparent);opacity:.75}#contacto .eyebrow{background:#6f00076b;border-color:#ffffff59;box-shadow:0 8px 24px #0004,0 0 0 4px #ffffff0b;backdrop-filter:blur(3px);text-shadow:0 2px 5px #000}#planes .eyebrow{position:relative;color:#fff;background:linear-gradient(145deg,#1b1c21e8,#0b0c0fe8);border:1px solid #ff3e46;padding:10px 18px;border-radius:8px;font-size:12px;font-weight:950;letter-spacing:.13em;text-transform:uppercase;box-shadow:0 0 0 4px #ed1c2410,0 9px 24px #0005}#planes .eyebrow:before{width:9px;height:9px;background:#ff3038;border-radius:2px;transform:rotate(45deg);box-shadow:0 0 10px #ff3038}#planes{background:radial-gradient(circle at 85% 5%,#3a0d124f 0,transparent 32%),linear-gradient(180deg,#0d0e12,#121318)}.tabs .tab{background:#191b20;color:#c9ccd2;border-color:#303239}.tabs .tab:hover{border-color:#ed1c24;color:#fff}.tabs .tab.active{background:#ed1c24;color:#fff;border-color:#ed1c24;box-shadow:0 8px 22px #ed1c2430}.card{background:linear-gradient(155deg,#1b1d23,#131419);border-color:#30323a;box-shadow:0 15px 38px #0004}.card.featured{border-color:#ed1c24;background:linear-gradient(155deg,#25171a,#151519);box-shadow:0 20px 52px #ed1c241d}.card .type,.card .period{color:#aeb2bb}.card .speed,.card .price{color:#fff}.features{border-color:#34363d}.features li{color:#d7d9de}.badge{background:#ed1c24;color:#fff}.disclaimer{color:#8f939c}.benefits{background:radial-gradient(circle at 10% 60%,#4b0c143f 0,transparent 30%),#0c0d10}.benefit{background:linear-gradient(145deg,#1d1f25,#15161b);border:1px solid #2c2e35;box-shadow:0 12px 30px #0003}.benefit h3{color:#fff}.benefit p{color:#aeb2bb}.benefit .icon{background:#ed1c2420;color:#ff4249;border:1px solid #ed1c2438}#contacto{background:linear-gradient(180deg,#0c0d10,#111216)}#preguntas{background:radial-gradient(circle at 90% 30%,#3b0b113d 0,transparent 30%),#0c0d10}.faq-item{border-color:#2c2e34}.faq-q{color:#f3f4f6}.faq-q:hover{color:#ff464d}.faq-a{color:#aeb2bb}.form{background:#f7f7f8f2;color:#20232a}.form .field label{color:#272a30}.form .field input{background:#fff;color:#20232a}.check{color:#626873}footer{background:#050506;border-top:1px solid #24262b}.foot{color:#aeb2bb}.foot .brand{color:#fff}
  </style>
</head>
<body>
  <div class="dealer-ribbon"><span>Distribuidor Autorizado Claro</span><a class="dealer-phone" href="https://wa.me/51987456123?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20planes%20de%20internet" target="_blank" rel="noopener" aria-label="Conversar por WhatsApp al 987 456 123">☎ 987 456 123</a></div>
  <main>
    <section class="hero"><div class="carousel" aria-label="Promociones destacadas"><div class="carousel-track">
      <div class="slide"><a class="slide-link" href="#contacto" aria-label="Solicitar la promoción Router 1"><img class="slide-promo" src="diapositiva-1.png" alt="Promoción de router e internet para el hogar"></a></div>
      <div class="slide"><a class="slide-link" href="#contacto" aria-label="Solicitar la promoción de fibra óptica y fútbol"><img class="slide-promo" src="diapositiva-2.png" alt="Internet fibra óptica con entretenimiento y fútbol"></a></div>
      <div class="slide"><a class="slide-link" href="#contacto" aria-label="Solicitar la promoción de fibra óptica y películas"><img class="slide-promo" src="diapositiva-3.png" alt="Internet fibra óptica para disfrutar películas en familia"></a></div>
    </div><button class="carousel-arrow prev" type="button" aria-label="Promoción anterior">‹</button><button class="carousel-arrow next" type="button" aria-label="Siguiente promoción">›</button><div class="carousel-dots"><button class="carousel-dot active" type="button" aria-label="Ver promoción 1"></button><button class="carousel-dot" type="button" aria-label="Ver promoción 2"></button><button class="carousel-dot" type="button" aria-label="Ver promoción 3"></button></div></div></section>
    <section id="planes"><div class="wrap"><div class="section-head"><span class="eyebrow">Elige tu conexión</span><h2>Planes pensados para cada hogar</h2><p>Selecciona una categoría y encuentra la velocidad que acompaña tu ritmo.</p></div><div class="tabs"><button class="tab active" data-filter="all">Todos</button><button class="tab" data-filter="internet">Solo Internet</button><button class="tab" data-filter="duo">Internet + Telefonía</button><button class="tab" data-filter="trio">Internet + TV</button></div><div class="cards">
      <article class="card" data-type="internet"><span class="type">Solo Internet</span><div class="speed">200 <small>Mbps</small></div><div class="bonus">Duplicamos tu velocidad por 6 meses</div><div class="price"><span class="currency">S/</span><span class="amount">69</span><span class="cents">.90</span><span class="period">al mes</span></div><ul class="features"><li>Router WiFi incluido</li><li>Instalación sin costo, previa evaluación</li><li>Ideal para 3 a 5 dispositivos</li></ul><button class="btn request" data-plan="Internet 200 Mbps">Solicitar plan</button></article>
      <article class="card featured" data-type="duo"><span class="badge">MÁS ELEGIDO</span><span class="type">Internet + Telefonía</span><div class="speed">400 <small>Mbps</small></div><div class="bonus">Hasta 1000 Mbps por 12 meses</div><div class="price"><span class="currency">S/</span><span class="amount">84</span><span class="cents">.90</span><span class="period">al mes</span></div><ul class="features"><li>Llamadas nacionales incluidas</li><li>Repetidor WiFi sujeto a evaluación</li><li>Conexión para toda la familia</li></ul><button class="btn request" data-plan="Dúo 400 Mbps">Solicitar plan</button></article>
      <article class="card" data-type="trio"><span class="type">Internet + TV</span><div class="speed">600 <small>Mbps</small></div><div class="bonus">Entretenimiento y velocidad en uno</div><div class="price"><span class="currency">S/</span><span class="amount">99</span><span class="cents">.90</span><span class="period">al mes</span></div><ul class="features"><li>Más de 90 canales</li><li>Decodificador incluido</li><li>WiFi de alto rendimiento</li></ul><button class="btn request" data-plan="Internet + TV 600 Mbps">Solicitar plan</button></article>
    </div><p class="disclaimer">Precios referenciales. Beneficios, disponibilidad y condiciones sujetos a evaluación de cobertura y operador.</p></div></section>
    <section class="benefits" id="beneficios"><div class="wrap"><div class="section-head"><span class="eyebrow">Una conexión que suma</span><h2>Más razones para conectarte</h2></div><div class="benefit-grid"><div class="benefit"><div class="icon">⚡</div><h3>Mayor velocidad</h3><p>Disfruta videollamadas, streaming y juegos con mayor estabilidad.</p></div><div class="benefit"><div class="icon">⌂</div><h3>Para todo tu hogar</h3><p>Conecta celulares, televisores y computadoras al mismo tiempo.</p></div><div class="benefit"><div class="icon">◉</div><h3>Cobertura verificada</h3><p>Validamos disponibilidad técnica antes de coordinar tu instalación.</p></div><div class="benefit"><div class="icon">☻</div><h3>Ayuda personalizada</h3><p>Un asesor te acompaña para encontrar una alternativa conveniente.</p></div></div></div></section>
    <section id="contacto"><div class="wrap contact"><div><span class="eyebrow">Te llamamos gratis</span><h2>Encuentra el plan perfecto para ti.</h2><p>Déjanos tus datos. Un asesor revisará la cobertura en tu zona y te contará las promociones disponibles.</p></div><form class="form" id="leadForm"><div class="field"><label for="name">Nombre y apellido</label><input id="name" name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required></div><div class="field"><label for="phone">Número de celular</label><input id="phone" name="phone" inputmode="numeric" pattern="[0-9]{9}" maxlength="9" placeholder="999 999 999" required></div><div class="field"><label for="district">Distrito</label><input id="district" name="district" placeholder="Ej. Miraflores" required></div><label class="check"><input type="checkbox" required> Acepto el tratamiento de mis datos para recibir información comercial según la política de privacidad.</label><input type="hidden" id="selectedPlan" name="plan"><button class="btn" type="submit">Solicitar llamada</button><div class="message" id="message"></div></form></div></section>
    <section id="preguntas"><div class="wrap"><div class="section-head"><span class="eyebrow">Resolvemos tus dudas</span><h2>Preguntas frecuentes</h2></div><div class="faq"><div class="faq-item"><button class="faq-q">¿Cómo sé si hay cobertura en mi zona?<span class="plus">+</span></button><div class="faq-a">Al dejar tus datos, un asesor validará la cobertura con la dirección exacta antes de coordinar cualquier instalación.</div></div><div class="faq-item"><button class="faq-q">¿Qué necesito para contratar?<span class="plus">+</span></button><div class="faq-a">Por lo general se solicita un documento de identidad vigente, dirección de instalación y pasar una evaluación comercial.</div></div><div class="faq-item"><button class="faq-q">¿Los precios promocionales son permanentes?<span class="plus">+</span></button><div class="faq-a">No siempre. La duración y el precio regular dependen de la promoción y del operador. El asesor debe informarte las condiciones antes de contratar.</div></div><div class="faq-item"><button class="faq-q">¿Cuánto demora la instalación?<span class="plus">+</span></button><div class="faq-a">El plazo depende de la cobertura y disponibilidad técnica. Una vez validada, se coordina contigo la fecha de visita.</div></div></div></div></section>
  </main>
  <footer><div class="wrap foot"><div class="brand"><img class="brand-mark" src="logo-claro.png" alt="Claro"> Conecta Hogar</div><span>© 2026 · Sitio informativo de asesoría comercial</span><span>Privacidad · Términos y condiciones</span></div></footer><a class="wa" href="https://wa.me/51987456123?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20planes%20de%20internet" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp al 987 456 123">◔</a>
  <script>
    const tabs=document.querySelectorAll('.tab'),cards=document.querySelectorAll('.card');tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');cards.forEach(c=>c.style.display=t.dataset.filter==='all'||c.dataset.type===t.dataset.filter?'flex':'none')}));
    document.querySelectorAll('.request').forEach(b=>b.addEventListener('click',()=>{document.querySelector('#selectedPlan').value=b.dataset.plan;document.querySelector('#contacto').scrollIntoView({behavior:'smooth'});setTimeout(()=>document.querySelector('#name').focus(),500)}));
    document.querySelectorAll('.faq-q').forEach(q=>q.addEventListener('click',()=>q.parentElement.classList.toggle('open')));
    const track=document.querySelector('.carousel-track'),dots=[...document.querySelectorAll('.carousel-dot')],slides=document.querySelectorAll('.slide');let currentSlide=0,carouselTimer;function showSlide(i){currentSlide=(i+slides.length)%slides.length;track.style.transform=`translateX(-${currentSlide*100}%)`;dots.forEach((d,n)=>d.classList.toggle('active',n===currentSlide))}function startCarousel(){clearInterval(carouselTimer);carouselTimer=setInterval(()=>showSlide(currentSlide+1),4000)}document.querySelector('.carousel-arrow.next').addEventListener('click',()=>{showSlide(currentSlide+1);startCarousel()});document.querySelector('.carousel-arrow.prev').addEventListener('click',()=>{showSlide(currentSlide-1);startCarousel()});dots.forEach((d,i)=>d.addEventListener('click',()=>{showSlide(i);startCarousel()}));startCarousel();
    const SHEETS_ENDPOINT='https://script.google.com/macros/s/AKfycbwgg8e7JjqBZ6FPK94qK0nUo-37Zdp8Ts0yREDOXSepKDcvbBJK4xxJQLeKgGk5s3Dq/exec';
    document.querySelector('#leadForm').addEventListener('submit',async e=>{e.preventDefault();const form=e.target,p=document.querySelector('#phone'),message=document.querySelector('#message'),button=form.querySelector('button[type="submit"]');if(!/^9\d{8}$/.test(p.value.replace(/\s/g,''))){message.textContent='Ingresa un celular peruano válido de 9 dígitos.';message.style.color='#e3262e';return}const data=new URLSearchParams(new FormData(form));data.set('phone',p.value.replace(/\s/g,''));button.disabled=true;button.textContent='Enviando...';message.textContent='';try{await fetch(SHEETS_ENDPOINT,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:data.toString()});message.style.color='#19b66a';message.textContent='¡Listo! Tu solicitud fue registrada.';form.reset()}catch(error){message.style.color='#e3262e';message.textContent='No pudimos enviar tus datos. Inténtalo nuevamente.'}finally{button.disabled=false;button.textContent='Solicitar llamada'}});
  </script>
</body>
</html>
